{
    "installCommand": "npm install --legacy-peer-deps",
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        },
        {
            "src": "src/**/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",  
            "dest": "/index.js" 
        },
        {
            "src": "/(.*)",   
            "dest": "/src/$1"    
        }
    ],
    
        "headers": [
          {
            "source": "/socket.io/(.*)",
            "headers": [
              { "key": "Access-Control-Allow-Credentials", "value": "true" },
              { "key": "Access-Control-Allow-Origin", "value": "https://chat-app-frontend-eta-fawn.vercel.app" },
              { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
              { "key": "Access-Control-Allow-Headers", "value": "Authorization,Content-Type" }
            ]
          }
        ]
      }

