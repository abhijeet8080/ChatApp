{
    "version": 2,
    "routes": [
      {
        "src": "/socket.io/(.*)",
        "dest": "/socket.io/$1",
        "headers": {
          "Access-Control-Allow-Credentials": "true",
          "Access-Control-Allow-Origin": "https://chat-app-frontend-eta-fawn.vercel.app",
          "Access-Control-Allow-Methods": "GET,OPTIONS,POST",
          "Access-Control-Allow-Headers": "Authorization,Content-Type"
        }
      },
      {
        "src": "/api/(.*)",
        "dest": "/api/$1"
      },
      {
        "src": "/(.*)",
        "dest": "/$1"
      }
    ]
  }